{
  "name": "saint-pierre-stage-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "nodemon --exec 'ts-node --esm' backend/server.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --reporter=verbose",
    "test:unit:watch": "vitest --watch",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:backend": "vitest run tests/unit/backend --reporter=verbose",
    "test:frontend": "vitest run tests/unit/frontend --reporter=verbose",
    "test:all": "vitest run tests --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:coverage:html": "vitest run --coverage && open coverage/index.html",
    "test:debug": "vitest --inspect-brk --inspect --single-thread",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:setup": "npm run prisma:migrate && npm run prisma:seed",
    "prisma:studio": "npx prisma studio --browser none --port 5555"
  },
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.1",
    "glob": "^13.0.6",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "naive-ui": "^2.44.1",
    "node-cron": "^4.2.1",
    "node-mailjet": "^6.0.11",
    "nodemailer": "^8.0.7",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "supertest": "^7.2.2",
    "uuid": "^14.0.0",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/vue": "^8.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsdom": "^28.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.0.2",
    "nodemon": "^3.1.14",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.40.1",
    "prettier": "3.8.3",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^25.9.0 || >=22.12.0"
  }
}
