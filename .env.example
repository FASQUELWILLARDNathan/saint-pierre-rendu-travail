###############################################
# DATABASE CONFIGURATION
###############################################

DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=5432

# Format : postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://your_db_user:your_db_password@postgres:5432/your_db_name


###############################################
# API / BACKEND CONFIGURATION
###############################################

# Port local du backend
API_PORT=3000

# URL publique du backend (à remplacer par l’informaticien)
# Exemple : https://api.saint-pierre.fr
API_URL=http://localhost:3000

NODE_ENV=development


###############################################
# FRONTEND CONFIGURATION
###############################################

# Port local du frontend
FRONTEND_PORT=5173

# URL publique du frontend (à remplacer par l’informaticien)
# Exemple : https://saint-pierre.fr
FRONTEND_URL=http://localhost:5173

# Pour Vite (frontend)
VITE_API_URL=http://localhost:3000


###############################################
# AUTHENTICATION / SECURITY
###############################################

# Clé secrète JWT (générée une fois)
JWT_SECRET=your_jwt_secret_here


###############################################
# EMAIL CONFIGURATION (MAILJET)
###############################################

MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
MAILJET_FROM_EMAIL=noreply@yourdomain.fr
MAILJET_FROM_NAME=Saint-Pierre


###############################################
# DEFAULT ADMIN ACCOUNT
###############################################

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your_admin_password
