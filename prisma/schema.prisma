// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id_user           BigInt      @id @default(autoincrement())
  nom               String      @db.VarChar(50)
  prenom            String      @db.VarChar(50)
  login             String      @unique @db.VarChar(50)
  hashed_password   String      @db.VarChar(255)
  role              String      @db.VarChar(50)
  created_at        DateTime    @default(now())

  eleve             eleve?
  professeur        professeur?
  rendus            rendu[]
}

model eleve {
  id_user   BigInt    @id
  classe    String?   @db.VarChar(50)
  annee     String?   @db.VarChar(50)
  user      user      @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  rendus    rendu[]
}

model professeur {
  id_user               BigInt    @id
  matiere               String?   @db.VarChar(50)
  user                  user      @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  cours                 cours[]
  asso_professeur_devoirs assprofdevoir[]
}

model cours {
  id_cours              BigInt      @id @default(autoincrement())
  id_user               BigInt
  nom_cours             String      @db.VarChar(50)
  description_cours     String?     @db.Text
  professeur            professeur  @relation(fields: [id_user], references: [id_user])
  devoirs               devoir[]
}

model devoir {
  id_devoir             BigInt      @id @default(autoincrement())
  id_cours              BigInt
  nom_devoir            String      @db.VarChar(255)
  description_devoir    String?     @db.Text
  coefficient           Decimal?    @db.Decimal(5, 2)
  cours                 cours       @relation(fields: [id_cours], references: [id_cours])
  rendus                rendu[]
  professeurs           assprofdevoir[]
}

model assprofdevoir {
  id_user               BigInt
  id_devoir             BigInt
  professeur            professeur  @relation(fields: [id_user], references: [id_user])
  devoir                devoir      @relation(fields: [id_devoir], references: [id_devoir])

  @@id([id_user, id_devoir])
}

model rendu {
  id_rendu              BigInt      @id @default(autoincrement())
  id_devoir             BigInt
  id_user               BigInt
  date_rendu            DateTime?
  note                  Decimal?    @db.Decimal(5, 2)
  retour                String?     @db.VarChar(255)
  devoir                devoir      @relation(fields: [id_devoir], references: [id_devoir])
  eleve                 eleve       @relation(fields: [id_user], references: [id_user])

  @@unique([id_devoir, id_user])
  users user[]
}
