<VirtualHost *:443>
    ServerName www.neyznn.fr
    ServerAlias neyznn.fr

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/www.neyznn.fr/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/www.neyznn.fr/privkey.pem

    ProxyPreserveHost On

    # BACKEND (IMPORTANT : EN PREMIER)
    ProxyPass "/api/" "http://localhost:3000/api/"
    ProxyPassReverse "/api/" "http://localhost:3000/api/"

    # FRONTEND
    ProxyPass "/" "http://localhost:8089/"
    ProxyPassReverse "/" "http://localhost:8089/"
</VirtualHost>