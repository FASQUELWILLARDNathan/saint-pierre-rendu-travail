# Frontend Dockerfile
FROM node:22-alpine

WORKDIR /app

# Copy ONLY package files first (for Docker cache optimization)
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Install dependencies (using npm ci for reproducible builds)
RUN npm ci

# Copy the rest of the application AFTER npm install
COPY . .

# Expose the dev server port
EXPOSE 5173

# Run dev server
CMD ["npm", "run", "dev"]
