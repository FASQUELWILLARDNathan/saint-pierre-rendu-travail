# Backend API Dockerfile
FROM node:22-alpine

WORKDIR /app

# Copier UNIQUEMENT package.json pour que le cache fonctionne
COPY package*.json ./

# Installer les dépendances
RUN npm ci --only=production && npm ci --also=dev

# Copier la configuration Prisma
COPY prisma ./prisma/

# Générer le client Prisma
RUN npx prisma generate

# Maintenant copier le reste du code (après que npm cache soit construit)
COPY . .

# Exposer le port API
EXPOSE 3000

# CMD exécutera la commande définie dans docker-compose.yml
CMD ["npm", "run", "dev:api"]
